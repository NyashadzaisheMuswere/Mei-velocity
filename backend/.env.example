PORT=5000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_PASSWORD=replace_with_a_long_random_password
DRIVER_AUTH_SECRET=replace_with_a_long_random_secret
CUSTOMER_AUTH_SECRET=replace_with_a_long_random_secret
# Set to true only for local VS Code testing; the code prints in the backend terminal.
LOCAL_OTP_MODE=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
# Create a Verify Service in Twilio Console; required for free-trial OTP testing.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed for the legacy Programmable Messaging fallback when Verify is unset.
TWILIO_FROM_NUMBER=+15555550100
